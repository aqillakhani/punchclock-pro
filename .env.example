# ============================================================
# PunchClock Pro — Environment Variables (internal-use)
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Node / runtime ---
NODE_ENV=development
LOG_LEVEL=debug

# --- API ---
API_PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Database (PostgreSQL + TimescaleDB + PostGIS) ---
#
# IMPORTANT: the API must connect as a role WITHOUT SUPERUSER/BYPASSRLS.
# Tenant isolation is enforced by Postgres row-level security, and a
# superuser silently skips every policy — one org would then see another
# org's users, timesheets and pay rates with no error anywhere.
#
# The bootstrap role created by the Postgres image (POSTGRES_USER) IS a
# superuser. Use it only for migrations and seeds, then provision the
# least-privilege application role:
#
#   pnpm --filter @punchclock/api db:migrate            # as the owner
#   APP_DB_PASSWORD=... pnpm --filter @punchclock/api db:create-app-role
#
# ...and point DATABASE_URL at punchclock_app below.
DATABASE_URL=postgresql://punchclock_app:local-dev-app-password@localhost:5432/punchclock
# Owner connection, used only by `db:migrate` / `db:seed` / `db:create-app-role`.
OWNER_DATABASE_URL=postgresql://punchclock:punchclock@localhost:5432/punchclock
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# --- Redis (Socket.io cross-instance adapter) — OPTIONAL ---
# Leave unset to run a single API instance: Socket.io uses its in-memory
# adapter and /health reports redis "disabled". Set it only when running more
# than one API instance, so broadcasts fan out across them.
# `docker compose up` provides a local Redis at the URL below.
# REDIS_URL=redis://localhost:6379

# --- Auth (self-hosted: bcrypt + JWT) ---
JWT_SECRET=dev-only-secret-replace-in-prod-with-32-plus-random-chars
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# --- Web (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Build provenance (set to git SHA at deploy time; shown on GET /health) ---
APP_VERSION=dev

# --- Web app URL (used to build links inside transactional emails) ---
WEB_APP_URL=http://localhost:3000

# --- Error tracking (Sentry) — leave DSN blank to disable (default in dev) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Web (Next.js): public DSN + build-time source map upload creds
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Transactional email ---
# EMAIL_PROVIDER=log (default) writes emails to the server log; set to 'resend' to send for real.
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=PunchClock Pro <onboarding@resend.dev>

# --- Document storage (S3-compatible: Cloudflare R2 / AWS S3) ---
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
DOCUMENTS_PRESIGN_EXPIRY_SECONDS=900

# --- Scheduled background jobs ---
#
# The API runs its own periodic sweeps in-process: auto clock-out (closes
# punches left open past the org's cap) and audit-log pruning. Each pass takes
# a Postgres advisory lock, so running more than one API machine is safe.
#
# Leave enabled unless you drive `db:auto-clock-out` / `db:prune-audit` from an
# external scheduler — with both off, forgotten punches are never closed and a
# blocked worker cannot punch in again.
SCHEDULED_JOBS_ENABLED=true
AUTO_CLOCK_OUT_INTERVAL_MINUTES=60
AUDIT_LOG_PRUNE_INTERVAL_MINUTES=1440
SCHEDULED_JOBS_INITIAL_DELAY_SECONDS=30
